# GXTD-817: fork source/backend + rebuilt frontend, pinned upstream dependencies.
# Build frontend under Node 22 before docker build; do not copy mutable main assets.
FROM ghcr.io/open-webui/open-webui@sha256:2272b0fb7c8783a016bcc179abb467cfa34590c99c5e6560fe0e9155b4820a09
LABEL org.opencontainers.image.source="https://github.com/bshenderson/open-webui" \
      homelab.upstream.revision="c38885a1a737da4968f157092f304f3b5481d0bf" \
      homelab.change="GXTD-817-managed-v0.13.0"
RUN rm -rf /app/build /app/backend/open_webui
COPY build/ /app/build/
COPY backend/ /app/backend/

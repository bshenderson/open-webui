# GXTD-715: fork source/backend + rebuilt frontend, pinned upstream dependencies.
# Build frontend under Node 22 before docker build; do not copy mutable main assets.
FROM ghcr.io/open-webui/open-webui@sha256:10e6a78ba2d172493460a9e8a92c496aaa7a64dc4d26d622a2e95e0c736081c9
LABEL org.opencontainers.image.source="https://github.com/bshenderson/open-webui" \
      homelab.upstream.revision="6a18585ff4c2e5f6805f682222cfbc46dc669ef8" \
      homelab.change="GXTD-715-source-progress-canary"
RUN rm -rf /app/build /app/backend/open_webui
COPY build/ /app/build/
COPY backend/ /app/backend/
